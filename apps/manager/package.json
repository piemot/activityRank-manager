{
  "name": "@activityrank/manager",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node ./dist/app.js",
    "dev:run": "node --enable-source-maps ./dist/app.js",
    "dev": "nodemon --exec \"pnpm run build && pnpm run dev:run\"",
    "format": "prettier -w src",
    "typecheck": "tsc --noEmit",
    "build": "swc src --out-dir dist --copy-files --strip-leading-paths"
  },
  "dependencies": {
    "@activityrank/addition": "workspace:*",
    "@hono/node-server": "^1.12.2",
    "@hono/zod-validator": "^0.4.1",
    "@sapphire/snowflake": "^3.2.2",
    "croner": "^9.0.0",
    "hono": "^4.6.7",
    "ofetch": "^1.3.4",
    "promise-mysql": "^5.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@activityrank/typescript-config": "workspace:*",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.40",
    "nodemon": "^3.1.4",
    "typescript": "^5.4.4"
  },
  "nodemonConfig": {
    "ext": "js,ts",
    "watch": [
      "src/**/*.ts"
    ]
  }
}
